{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build && node scripts/generate-sitemaps.mjs && node scripts/prepare-vercel.mjs",
  "outputDirectory": "dist/haisrilanka/browser",
  "framework": null,
  "functions": {
    "api/bookings.js": {
      "maxDuration": 30
    },
    "api/contact.js": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "https://www.haisrilanka.com/en",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "haisrilanka.com" }],
      "destination": "https://www.haisrilanka.com/:path*",
      "permanent": true
    },
    {
      "source": "/:lang/multi day tours",
      "destination": "/:lang/multi-day-tours",
      "permanent": true
    },
    {
      "source": "/:lang/multi%20day%20tours",
      "destination": "/:lang/multi-day-tours",
      "permanent": true
    },
    {
      "source": "/:lang/multi_day_tours",
      "destination": "/:lang/multi-day-tours",
      "permanent": true
    },
    {
      "source": "/:lang/day tours",
      "destination": "/:lang/day-tours",
      "permanent": true
    },
    {
      "source": "/:lang/things to do",
      "destination": "/:lang/things-to-do",
      "permanent": true
    },
    {
      "source": "/:lang/sri lanka tours",
      "destination": "/:lang/sri-lanka-tours",
      "permanent": true
    },
    { "source": "/yalpanam.html", "destination": "/en", "permanent": true },
    { "source": "/tour.html", "destination": "/en/sri-lanka-tours", "permanent": true },
    { "source": "/packages.html", "destination": "/en/multi-day-tours", "permanent": true },
    { "source": "/services.html", "destination": "/en", "permanent": true },
    {
      "source": "/eightDaysTours.html",
      "destination": "/en/multi-day-tours",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/contact", "destination": "/api/contact" },
    { "source": "/api/bookings", "destination": "/api/bookings" },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=()" }
      ]
    },
    {
      "source": "/assets/i18n/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)\\.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)\\.css",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
