{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build && node scripts/generate-sitemaps.mjs && node scripts/prepare-vercel.mjs",
  "outputDirectory": "dist/haisrilanka/browser",
  "framework": null,
  "functions": {
    "api/ssr.ts": {
      "includeFiles": "dist/haisrilanka/**",
      "maxDuration": 30,
      "memory": 1024
    },
    "api/bookings.js": {
      "maxDuration": 30
    },
    "api/contact.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/contact", "destination": "/api/contact" },
    { "source": "/api/bookings", "destination": "/api/bookings" },
    { "source": "/", "destination": "/api/ssr?__path=/" },
    {
      "source": "/((?!assets/|api/).*)",
      "destination": "/api/ssr?__path=/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=()" }
      ]
    },
    {
      "source": "/assets/i18n/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)\\.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)\\.css",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
